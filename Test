import React, { useState } from "react";

export default function TSXFeeAdminMockup() {
  const [step, setStep] = useState(0);
  const [connected, setConnected] = useState(false);
  const [wallet, setWallet] = useState("TSX Administration");
  const [scanned, setScanned] = useState(false);
  const [harvested, setHarvested] = useState(false);
  const [withdrawn, setWithdrawn] = useState(false);
  const [splitDone, setSplitDone] = useState(false);

  const accounts = [
    { name: "Buyer #1 TSX Account", withheld: 30000 },
    { name: "Buyer #2 TSX Account", withheld: 12000 },
    { name: "Buyer #3 TSX Account", withheld: 18000 },
    { name: "TSX/SOL Liquidity Pool TSX Account", withheld: 45000 },
  ];

  const totalWithheld = accounts.reduce((sum, a) => sum + a.withheld, 0);
  const treasuryShare = totalWithheld / 3;
  const stabilityShare = totalWithheld / 3;
  const liquidityShare = totalWithheld / 6;
  const creatorShare = totalWithheld / 6;

  const buttonClass =
    "px-4 py-2 rounded-2xl font-medium shadow-sm border transition hover:shadow-md disabled:opacity-50 disabled:cursor-not-allowed";

  const StepCard = ({ num, title, body, active, done }) => (
    <div className={`rounded-3xl border p-4 ${active ? 'bg-white shadow-md' : 'bg-gray-50'} ${done ? 'border-green-500' : 'border-gray-200'}`}>
      <div className="flex items-center gap-3 mb-2">
        <div className={`h-9 w-9 rounded-full flex items-center justify-center text-sm font-bold ${done ? 'bg-green-600 text-white' : active ? 'bg-purple-700 text-white' : 'bg-gray-200 text-gray-700'}`}>
          {done ? '✓' : num}
        </div>
        <h3 className="text-lg font-semibold">{title}</h3>
      </div>
      <p className="text-sm text-gray-700 leading-6">{body}</p>
    </div>
  );

  return (
    <div className="min-h-screen bg-gradient-to-b from-zinc-950 via-zinc-900 to-black text-white p-6 md:p-10">
      <div className="max-w-7xl mx-auto space-y-6">
        <div className="rounded-[28px] border border-purple-500/30 bg-white/5 backdrop-blur p-6 md:p-8">
          <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
              <p className="uppercase tracking-[0.25em] text-xs text-purple-300 mb-2">Demo only · no real wallet connection</p>
              <h1 className="text-3xl md:text-4xl font-bold">TSX Fee Vault Admin Walkthrough</h1>
              <p className="text-zinc-300 mt-3 max-w-3xl leading-7">
                This mock page shows how the simple Token-2022 fee workflow would feel on your laptop: connect the admin wallet,
                scan withheld fees, harvest them to the TSX mint, withdraw them to TSX Fee Vault, then split them into your buckets.
              </p>
            </div>
            <div className="rounded-3xl bg-black/30 border border-white/10 p-4 min-w-[280px]">
              <div className="text-sm text-zinc-400 mb-1">Active mode</div>
              <div className="text-xl font-semibold">Simulation / Walkthrough</div>
              <div className="mt-3 text-sm text-zinc-300">No on-chain actions. No Phantom transaction requests.</div>
            </div>
          </div>
        </div>

        <div className="grid lg:grid-cols-[1.15fr_0.85fr] gap-6">
          <div className="rounded-[28px] border border-white/10 bg-white text-black overflow-hidden shadow-2xl">
            <div className="bg-zinc-100 border-b px-4 py-3 flex items-center gap-2">
              <div className="h-3 w-3 rounded-full bg-red-400"></div>
              <div className="h-3 w-3 rounded-full bg-yellow-400"></div>
              <div className="h-3 w-3 rounded-full bg-green-400"></div>
              <div className="ml-4 text-sm text-zinc-600">https://tsx.local/fee-admin-demo</div>
            </div>

            <div className="p-5 md:p-6 space-y-5">
              <div className="rounded-3xl border border-zinc-200 bg-zinc-50 p-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <div className="text-sm text-zinc-500">Connected authority wallet</div>
                  <div className="text-xl font-semibold">{connected ? wallet : 'Not connected'}</div>
                  <div className="text-sm text-zinc-600 mt-1">
                    {connected
                      ? 'This wallet signs the harvest and withdraw transactions.'
                      : 'In the real page, you would click Connect Phantom and choose TSX Administration.'}
                  </div>
                </div>
                <button
                  className={`${buttonClass} bg-purple-700 text-white border-purple-700`}
                  onClick={() => {
                    setConnected(true);
                    setStep(Math.max(step, 1));
                  }}
                >
                  {connected ? 'Phantom Connected' : 'Connect Phantom'}
                </button>
              </div>

              <div className="grid md:grid-cols-3 gap-4">
                <div className="rounded-3xl border border-zinc-200 p-4">
                  <div className="text-sm text-zinc-500">TSX Mint</div>
                  <div className="font-semibold mt-1">TSX Mint Account</div>
                  <div className="text-xs text-zinc-500 mt-2">Temporary on-chain holding point after harvest</div>
                </div>
                <div className="rounded-3xl border border-zinc-200 p-4">
                  <div className="text-sm text-zinc-500">Fee Destination</div>
                  <div className="font-semibold mt-1">TSX Fee Vault</div>
                  <div className="text-xs text-zinc-500 mt-2">Collected fees land here after withdraw</div>
                </div>
                <div className="rounded-3xl border border-zinc-200 p-4">
                  <div className="text-sm text-zinc-500">Fee Rule</div>
                  <div className="font-semibold mt-1">3% on TSX transfers</div>
                  <div className="text-xs text-zinc-500 mt-2">Buy, sell, and wallet-to-wallet TSX moves</div>
                </div>
              </div>

              <div className="rounded-3xl border border-zinc-200 p-4 space-y-4">
                <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                  <div>
                    <h2 className="text-xl font-semibold">1. Scan withheld fees</h2>
                    <p className="text-sm text-zinc-600 mt-1">
                      This looks for TSX recipient accounts that currently contain withheld fee amounts.
                    </p>
                  </div>
                  <button
                    className={`${buttonClass} bg-black text-white border-black`}
                    disabled={!connected}
                    onClick={() => {
                      setScanned(true);
                      setStep(Math.max(step, 2));
                    }}
                  >
                    Scan fees
                  </button>
                </div>

                <div className="rounded-2xl bg-zinc-50 border border-zinc-200 overflow-hidden">
                  <div className="grid grid-cols-[1fr_auto] gap-3 px-4 py-3 text-sm font-semibold border-b bg-zinc-100">
                    <div>Recipient TSX account</div>
                    <div>Withheld fee</div>
                  </div>
                  {accounts.map((a) => (
                    <div key={a.name} className="grid grid-cols-[1fr_auto] gap-3 px-4 py-3 border-b last:border-b-0 text-sm">
                      <div>{a.name}</div>
                      <div>{scanned ? `${a.withheld.toLocaleString()} TSX` : '—'}</div>
                    </div>
                  ))}
                </div>
              </div>

              <div className="rounded-3xl border border-zinc-200 p-4 space-y-4">
                <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                  <div>
                    <h2 className="text-xl font-semibold">2. Harvest to TSX mint</h2>
                    <p className="text-sm text-zinc-600 mt-1">
                      This sweeps withheld fee amounts out of the listed recipient TSX accounts and into the TSX mint account.
                    </p>
                  </div>
                  <button
                    className={`${buttonClass} bg-purple-700 text-white border-purple-700`}
                    disabled={!scanned}
                    onClick={() => {
                      setHarvested(true);
                      setStep(Math.max(step, 3));
                    }}
                  >
                    Harvest to mint
                  </button>
                </div>
                <div className="grid md:grid-cols-2 gap-4">
                  <div className="rounded-2xl bg-zinc-50 border border-zinc-200 p-4">
                    <div className="text-sm text-zinc-500">Before harvest</div>
                    <div className="mt-2 text-sm">Recipient accounts hold the withheld amounts.</div>
                  </div>
                  <div className="rounded-2xl bg-zinc-50 border border-zinc-200 p-4">
                    <div className="text-sm text-zinc-500">After harvest</div>
                    <div className="mt-2 text-lg font-semibold">{harvested ? `${totalWithheld.toLocaleString()} TSX` : '0 TSX'} on TSX mint</div>
                  </div>
                </div>
              </div>

              <div className="rounded-3xl border border-zinc-200 p-4 space-y-4">
                <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                  <div>
                    <h2 className="text-xl font-semibold">3. Withdraw to TSX Fee Vault</h2>
                    <p className="text-sm text-zinc-600 mt-1">
                      This moves the harvested fee balance from the TSX mint account into the TSX Fee Vault token account.
                    </p>
                  </div>
                  <button
                    className={`${buttonClass} bg-black text-white border-black`}
                    disabled={!harvested}
                    onClick={() => {
                      setWithdrawn(true);
                      setStep(Math.max(step, 4));
                    }}
                  >
                    Withdraw to Fee Vault
                  </button>
                </div>
                <div className="rounded-2xl bg-zinc-50 border border-zinc-200 p-4">
                  <div className="text-sm text-zinc-500">TSX Fee Vault balance</div>
                  <div className="text-2xl font-bold mt-1">{withdrawn ? `${totalWithheld.toLocaleString()} TSX` : '0 TSX'}</div>
                </div>
              </div>

              <div className="rounded-3xl border border-zinc-200 p-4 space-y-4">
                <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                  <div>
                    <h2 className="text-xl font-semibold">4. Split fees from Fee Vault</h2>
                    <p className="text-sm text-zinc-600 mt-1">
                      Once the fees are in TSX Fee Vault, you can do the regular wallet-to-wallet transfers you already understand.
                    </p>
                  </div>
                  <button
                    className={`${buttonClass} bg-purple-700 text-white border-purple-700`}
                    disabled={!withdrawn}
                    onClick={() => {
                      setSplitDone(true);
                      setStep(Math.max(step, 5));
                    }}
                  >
                    Preview split
                  </button>
                </div>
                <div className="grid sm:grid-cols-2 xl:grid-cols-4 gap-3">
                  {[
                    ['TSX Treasury', treasuryShare],
                    ['Treasury (track as Stability)', stabilityShare],
                    ['TSX Liquidity', liquidityShare],
                    ['TSX Creator', creatorShare],
                  ].map(([name, amount]) => (
                    <div key={name} className="rounded-2xl bg-zinc-50 border border-zinc-200 p-4">
                      <div className="text-sm text-zinc-500">{name}</div>
                      <div className="text-xl font-semibold mt-1">{splitDone ? `${amount.toLocaleString()} TSX` : '—'}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          <div className="space-y-5">
            <StepCard
              num="1"
              title="Connect TSX Administration"
              body="On the real page, you would click Connect Phantom, and Phantom would ask which wallet to connect. You would choose TSX Administration."
              active={step === 0 || step === 1}
              done={connected}
            />
            <StepCard
              num="2"
              title="Scan withheld fees"
              body="The page lists recipient TSX accounts that currently contain withheld fee amounts from buys, sells, or transfers."
              active={step === 2}
              done={scanned}
            />
            <StepCard
              num="3"
              title="Harvest to TSX mint"
              body="This is the sweep step. The withheld fees leave the recipient TSX accounts and move to the TSX mint account."
              active={step === 3}
              done={harvested}
            />
            <StepCard
              num="4"
              title="Withdraw to TSX Fee Vault"
              body="This moves the harvested amount from the TSX mint account into TSX Fee Vault, which is the wallet bucket you control afterward."
              active={step === 4}
              done={withdrawn}
            />
            <StepCard
              num="5"
              title="Split to your buckets"
              body="From Fee Vault, you make normal wallet-to-wallet transfers to Treasury, Treasury-as-Stability, Liquidity, and Creator."
              active={step === 5}
              done={splitDone}
            />

            <div className="rounded-[28px] border border-emerald-400/30 bg-emerald-500/10 p-5">
              <h3 className="text-lg font-semibold mb-2">What this mockup is proving</h3>
              <ul className="space-y-2 text-sm text-zinc-200 leading-6 list-disc pl-5">
                <li>You would use a normal webpage on your laptop.</li>
                <li>Phantom is only used to approve the harvest and withdraw transactions.</li>
                <li>TSX Admin is the signing wallet, not the place the fees finally live.</li>
                <li>TSX Fee Vault is the place the fees end up before you split them.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
